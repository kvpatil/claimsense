# --- secrets -----------------------------------------------------------------
# keys.env holds every credential and must NEVER be committed. .env is wiring
# only, but it is ignored too so a local override cannot travel by accident.
# Only the .example files ship.
#
# A ClaimSense key looks like `csk_…`; an AWS one starts `AKIA`. If either ever
# shows up in a diff, stop and strip it.
keys.env
.env
.env.local
*.env
!*.env.example

# --- python ------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# --- node --------------------------------------------------------------------
node_modules/
.next/
out/
npm-debug.log*

# --- os ----------------------------------------------------------------------
.DS_Store

# --- run artifacts -----------------------------------------------------------
# Eval output is regenerated by `make eval`; evidence/ captures are committed on
# purpose, so they are NOT listed here.
.claimsense-run/

# The agent venv. `make venv` recreates it; pytest is the only thing in it.
agent/.venv/

# Next build output and local env
platform/web/.next/
platform/web/.env.local
