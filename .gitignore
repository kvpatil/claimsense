# --- secrets -----------------------------------------------------------------
# Only the .example files ship. A ClaimSense key looks like `csk_…`; if one ever
# shows up in a diff, stop and strip it.
.env
.env.local
*.env
!*.env.example

# --- python ------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# --- node --------------------------------------------------------------------
node_modules/
.next/
out/
npm-debug.log*

# --- os ----------------------------------------------------------------------
.DS_Store

# --- run artifacts -----------------------------------------------------------
# Eval output is regenerated by `make eval`; evidence/ captures are committed on
# purpose, so they are NOT listed here.
.claimsense-run/
