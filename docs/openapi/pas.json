{
  "openapi": "3.0.3",
  "info": {
    "title": "ClaimSense ⇄ Policy Administration System",
    "version": "1.0.0",
    "description": "Cover, limits, deductibles and the policy clause corpus. READ-ONLY. There is no write contract, deliberately: a claims co-pilot that could alter a policy could manufacture the coverage it then finds."
  },
  "servers": [
    {
      "url": "http://localhost:3200/api/pas/v1"
    }
  ],
  "components": {
    "schemas": {
      "ApiError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "hint": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      },
      "Coverage": {
        "type": "object",
        "properties": {
          "coverage_id": {
            "type": "integer"
          },
          "policy_id": {
            "type": "integer"
          },
          "coverage_code": {
            "type": "string",
            "enum": [
              "DWELL",
              "PP",
              "LIAB",
              "ALE",
              "COLL",
              "COMP"
            ]
          },
          "limit_cents": {
            "type": "integer",
            "description": "amount in integer cents"
          },
          "deductible_cents": {
            "$ref": "#/definitions/Coverage/properties/limit_cents"
          },
          "coinsurance_pct": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          }
        },
        "required": [
          "coverage_id",
          "policy_id",
          "coverage_code",
          "limit_cents",
          "deductible_cents",
          "coinsurance_pct"
        ],
        "additionalProperties": false
      },
      "GetClausesResponse": {
        "type": "object",
        "properties": {
          "clauses": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "clause_id": {
                  "type": "string"
                },
                "product": {
                  "anyOf": [
                    {
                      "type": "string",
                      "enum": [
                        "HO3",
                        "HO4",
                        "AUTO"
                      ]
                    },
                    {
                      "type": "string",
                      "const": "ALL"
                    }
                  ]
                },
                "section": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "clause_type": {
                  "type": "string",
                  "enum": [
                    "grant",
                    "exclusion",
                    "condition",
                    "definition",
                    "limit"
                  ]
                },
                "body": {
                  "type": "string"
                },
                "perils": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "fire",
                      "water",
                      "wind",
                      "theft",
                      "vandalism",
                      "earthquake",
                      "collision",
                      "liability"
                    ]
                  }
                },
                "keywords": {
                  "type": "string"
                }
              },
              "required": [
                "clause_id",
                "product",
                "section",
                "title",
                "clause_type",
                "body",
                "perils"
              ],
              "additionalProperties": false
            }
          },
          "count": {
            "type": "integer"
          }
        },
        "required": [
          "clauses",
          "count"
        ],
        "additionalProperties": false
      },
      "GetCoveragesResponse": {
        "type": "object",
        "properties": {
          "policy_id": {
            "type": "integer"
          },
          "coverages": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "coverage_id": {
                  "type": "integer"
                },
                "policy_id": {
                  "type": "integer"
                },
                "coverage_code": {
                  "type": "string",
                  "enum": [
                    "DWELL",
                    "PP",
                    "LIAB",
                    "ALE",
                    "COLL",
                    "COMP"
                  ]
                },
                "limit_cents": {
                  "type": "integer",
                  "description": "amount in integer cents"
                },
                "deductible_cents": {
                  "$ref": "#/definitions/GetCoveragesResponse/properties/coverages/items/properties/limit_cents"
                },
                "coinsurance_pct": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100
                }
              },
              "required": [
                "coverage_id",
                "policy_id",
                "coverage_code",
                "limit_cents",
                "deductible_cents",
                "coinsurance_pct"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "policy_id",
          "coverages"
        ],
        "additionalProperties": false
      },
      "GetPolicyResponse": {
        "type": "object",
        "properties": {
          "policy": {
            "type": "object",
            "properties": {
              "policy_id": {
                "type": "integer"
              },
              "policy_number": {
                "type": "string"
              },
              "insured_id": {
                "type": "integer"
              },
              "product": {
                "type": "string",
                "enum": [
                  "HO3",
                  "HO4",
                  "AUTO"
                ]
              },
              "effective_date": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                "description": "calendar date, YYYY-MM-DD"
              },
              "expiration_date": {
                "$ref": "#/definitions/GetPolicyResponse/properties/policy/properties/effective_date"
              },
              "status": {
                "type": "string",
                "enum": [
                  "active",
                  "lapsed",
                  "cancelled"
                ]
              },
              "lapse_date": {
                "anyOf": [
                  {
                    "$ref": "#/definitions/GetPolicyResponse/properties/policy/properties/effective_date"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "calendar date, YYYY-MM-DD"
              },
              "premium_cents": {
                "type": "integer",
                "description": "amount in integer cents"
              },
              "payment_status": {
                "type": "string",
                "enum": [
                  "current",
                  "late",
                  "delinquent"
                ]
              }
            },
            "required": [
              "policy_id",
              "policy_number",
              "insured_id",
              "product",
              "effective_date",
              "expiration_date",
              "status",
              "lapse_date",
              "premium_cents",
              "payment_status"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "policy"
        ],
        "additionalProperties": false
      },
      "Policy": {
        "type": "object",
        "properties": {
          "policy_id": {
            "type": "integer"
          },
          "policy_number": {
            "type": "string"
          },
          "insured_id": {
            "type": "integer"
          },
          "product": {
            "type": "string",
            "enum": [
              "HO3",
              "HO4",
              "AUTO"
            ]
          },
          "effective_date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "calendar date, YYYY-MM-DD"
          },
          "expiration_date": {
            "$ref": "#/definitions/Policy/properties/effective_date"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "lapsed",
              "cancelled"
            ]
          },
          "lapse_date": {
            "anyOf": [
              {
                "$ref": "#/definitions/Policy/properties/effective_date"
              },
              {
                "type": "null"
              }
            ],
            "description": "calendar date, YYYY-MM-DD"
          },
          "premium_cents": {
            "type": "integer",
            "description": "amount in integer cents"
          },
          "payment_status": {
            "type": "string",
            "enum": [
              "current",
              "late",
              "delinquent"
            ]
          }
        },
        "required": [
          "policy_id",
          "policy_number",
          "insured_id",
          "product",
          "effective_date",
          "expiration_date",
          "status",
          "lapse_date",
          "premium_cents",
          "payment_status"
        ],
        "additionalProperties": false
      },
      "PolicyClause": {
        "type": "object",
        "properties": {
          "clause_id": {
            "type": "string"
          },
          "product": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "HO3",
                  "HO4",
                  "AUTO"
                ]
              },
              {
                "type": "string",
                "const": "ALL"
              }
            ]
          },
          "section": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "clause_type": {
            "type": "string",
            "enum": [
              "grant",
              "exclusion",
              "condition",
              "definition",
              "limit"
            ]
          },
          "body": {
            "type": "string"
          },
          "perils": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "fire",
                "water",
                "wind",
                "theft",
                "vandalism",
                "earthquake",
                "collision",
                "liability"
              ]
            }
          },
          "keywords": {
            "type": "string"
          }
        },
        "required": [
          "clause_id",
          "product",
          "section",
          "title",
          "clause_type",
          "body",
          "perils"
        ],
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Scoped to the PAS contract. A key for another system is refused with 403 wrong_system."
      }
    }
  },
  "paths": {
    "/policies/{id}": {
      "get": {
        "summary": "One policy. 404 is a CONTRACTUAL outcome — the claim/policy reference crosses a vendor boundary with no foreign key, so a dangling id is reachable and must be reported, never a 500.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "401": {
            "description": "No or unrecognised key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "Key is valid but scoped to another system, or the seat may not access this resource",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "422": {
            "description": "Body failed contract validation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/policies/{id}/coverages": {
      "get": {
        "summary": "Limits, deductibles and coinsurance.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "401": {
            "description": "No or unrecognised key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "Key is valid but scoped to another system, or the seat may not access this resource",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "422": {
            "description": "Body failed contract validation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/clauses": {
      "get": {
        "summary": "The policy clause corpus retrieval ranks over.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "401": {
            "description": "No or unrecognised key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "Key is valid but scoped to another system, or the seat may not access this resource",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "422": {
            "description": "Body failed contract validation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    }
  }
}
