# Copy to .env and adjust. Nothing here is required for the $0 mock path —
# `make verify` runs with no key, no network, and no cloud account.

# ---- the platform -----------------------------------------------------------
# Postgres deliberately on 5433, not 5432: the Meridian reference stack uses
# 5432 and the two are often up at the same time.
CLAIMSENSE_DB_URL=postgresql://claimsense:claimsense@localhost:5433/claimsense

# The three client systems. One Next.js app serves all three namespaces, but the
# agent talks to each through its OWN base URL and its OWN key, because they are
# three separate vendor systems in the engagement and the contracts differ.
CMS_BASE_URL=http://localhost:3200/api/cms/v1
PAS_BASE_URL=http://localhost:3200/api/pas/v1
DMS_BASE_URL=http://localhost:3200/api/dms/v1
CLAIMSENSE_CONSOLE_URL=http://localhost:3200

# Scoped keys, minted by `make keys`. Print once — they are stored hashed.
CMS_API_KEY=
PAS_API_KEY=
DMS_API_KEY=

# ---- the brain --------------------------------------------------------------
# Absent => mock. Mock IS the CI brain; the live path is never required to pass
# a gate. Set a key only when you want to exercise the real Agents SDK path.
OPENAI_API_KEY=
CLAIMSENSE_MODEL=gpt-5.4-mini
