# Copy to .env. WIRING ONLY — no secrets. Credentials live in keys.env.
#
# Both files are loaded, keys.env second. A value already exported in the
# environment wins over either, so CI and the container override without
# editing anything.

# --- the platform ---------------------------------------------------------
# Postgres deliberately on 5433, not 5432: the Meridian reference stack binds
# 5432 and the two are often up at the same time.
CLAIMSENSE_DB_URL=postgresql://claimsense:claimsense@localhost:5433/claimsense

# The three client systems. One Next.js app serves all three namespaces, but
# the agent talks to each through its OWN base URL and its OWN key, because in
# the engagement they are three vendors with three contracts.
CMS_BASE_URL=http://localhost:3200/api/cms/v1
PAS_BASE_URL=http://localhost:3200/api/pas/v1
DMS_BASE_URL=http://localhost:3200/api/dms/v1
CLAIMSENSE_CONSOLE_URL=http://localhost:3200

# --- model routing --------------------------------------------------------
# Cost engineering: the cheap model does the high-volume stages, the expensive
# one touches only Coverage — the step where money moves.
CLAIMSENSE_MODEL_FAST=bedrock/converse/us.anthropic.claude-haiku-4-5-20251001-v1:0
CLAIMSENSE_MODEL_SMART=bedrock/converse/us.anthropic.claude-sonnet-4-5-20250929-v1:0
