# Copy to keys.env and fill in. keys.env is gitignored — never share it.
#
# SECRETS ONLY. Everything that is merely wiring — base URLs, the local
# Postgres DSN, model ids — lives in .env, which is safe to read over someone's
# shoulder. Splitting them means a screenshare, a pasted log or a `cat .env`
# cannot leak a credential, and it keeps the one file you must never commit
# small enough to check by eye.
#
# Nothing here is required for the $0 path. `make verify` and `make eval` run
# on the mock brain with this file absent.

# --- AWS (Bedrock) --------------------------------------------------------
# The lab page's accessId and accessKey — use the copy buttons, don't retype.
# Needed only for `--live` runs against Claude on Bedrock.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# --- OpenAI ---------------------------------------------------------------
# platform.openai.com → API keys. An alternative to Bedrock, not an addition:
# brain.py prefers AWS when both are present.
OPENAI_API_KEY=

# --- ClaimSense scoped keys ----------------------------------------------
# Minted by `make keys`, which writes them here for you. Three keys, because
# the three client systems have three separate contracts — a CMS key presented
# to PAS is refused with 403 wrong_system.
#
# Stored hashed in the database; the plaintext exists only in this file.
CMS_API_KEY=
PAS_API_KEY=
DMS_API_KEY=
